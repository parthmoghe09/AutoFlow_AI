# Environment Variable Configuration Template
# COPY THIS FILE TO .env OR .env.local AND REPLACE WITH YOUR ACTUAL CREDENTIALS.
# DO NOT COMMIT REAL CREDENTIALS OR DATABASE PASSWORDS TO GIT.

# Backend Server Configuration
PORT=3001
NODE_ENV=production
JWT_SECRET=your_secure_jwt_secret_here

# PostgreSQL / Neon Database Connection Strings
# Replace user, password, host, and database name with your credentials.
DATABASE_URL="postgresql://username:password@your-postgres-host:5432/autoflow?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://username:password@your-postgres-host:5432/autoflow?sslmode=require"
NEON_BRANCH=production

# Database Parameters (if using separate env vars)
DB_HOST=postgres-service
DB_PORT=5432
DB_NAME=autoflow
DB_USER=autoflow_user
DB_PASSWORD=your_db_password_here

# Frontend Configuration
VITE_API_URL="http://localhost:3001"
